[Unit]
Description=Weekly Strudel bank discovery crawl for the crate app
Documentation=file:///home/builder/apps/crate/docs/superpowers/specs/2026-06-23-bank-discovery-crawler-design.md

[Timer]
# Weekly, Monday 04:30. Persistent so a missed run (box off) fires on next boot.
OnCalendar=Mon *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
