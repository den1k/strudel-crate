node_modules/
dist/
.DS_Store
.env*

# listener ratings/notes are local runtime data (the dev server rewrites them);
# keep them untracked so branch switches never drop them
data/ratings/
data/stem-ratings/
data/jobs/

# generation agents' scratch dir; save scripts delete files on success
staging/

# bespoke per-batch kit artifacts written by Stage 1 (generate-tracks); keep the
# dir, ignore the generated palettes (regenerated fresh every batch)
palettes/*.json

# git worktrees for isolated Claude sessions
.claude/worktrees/
# vendored sample banks (cache-on-save); re-fetchable, large binaries
data/sample-cache/
