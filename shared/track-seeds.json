{
  "sources": [
    { "id": "four-on-floor-909", "family": "four-on-floor", "genre": "techno", "appliesTo": "any",
      "frag": "s(\"bd*4\").bank(\"RolandTR909\").gain(1.1)",
      "note": "Driving 4/4 kick. Pair with any harmonic engine; vary the bank per batch." },
    { "id": "broken-808", "family": "broken", "genre": "trap", "appliesTo": "any",
      "frag": "s(\"bd ~ [~ bd] ~\").bank(\"RolandTR808\").gain(1.1)",
      "note": "Broken/syncopated 808 kick; trap or downtempo feel." },
    { "id": "breakbeat-linn", "family": "breakbeat", "genre": "breakbeat", "appliesTo": "any",
      "frag": "s(\"bd ~ sd [bd bd]\").bank(\"LinnDrum\").gain(1.0)",
      "note": "Breakbeat skeleton; add ghost hats." },
    { "id": "half-time-dmx", "family": "half-time", "genre": "downtempo", "appliesTo": "any",
      "frag": "s(\"bd ~ ~ ~ sd ~ ~ ~\").bank(\"OberheimDMX\").gain(1.0)",
      "note": "Half-time heavy groove; trip-hop/downtempo." },
    { "id": "no-drums-pad", "family": "beatless", "genre": "ambient", "appliesTo": "any",
      "frag": "note(\"<c2 ab1>/2\").s(\"sawtooth\").lpf(500).room(0.5).gain(0.5)",
      "note": "Beatless pad bed; ambient starting point with no kit at all." },

    { "id": "boom-bap-akai", "family": "boom-bap", "genre": "hip-hop", "appliesTo": "any",
      "frag": "stack(s(\"bd ~ ~ bd ~ ~ bd ~\").bank(\"AkaiMPC60\").gain(1.0), s(\"~ sd ~ sd\").bank(\"AkaiMPC60\").gain(0.95)).swingBy(0.08, 8)",
      "note": "Dusty boom-bap kick+snare with MPC swing; lo-fi hip-hop." },
    { "id": "lofi-chopped-break", "family": "boom-bap", "genre": "hip-hop", "appliesTo": "any",
      "frag": "s(\"breaks165\").chop(8).slow(2).gain(0.85).lpf(2200)",
      "note": "Chopped vinyl break, slowed and filtered for lo-fi hip-hop." },
    { "id": "dub-one-drop", "family": "one-drop", "genre": "dub", "appliesTo": "any",
      "frag": "stack(s(\"~ ~ bd ~\").bank(\"RolandTR808\").gain(1.05), s(\"~ cp ~ cp\").bank(\"RolandTR808\").room(0.4).gain(0.7)).swingBy(0.05, 8)",
      "note": "Dub/reggae one-drop: kick on the 3, clap echoes." },
    { "id": "dub-techno-pulse", "family": "four-on-floor", "genre": "dub", "appliesTo": "any",
      "frag": "stack(s(\"bd*4\").bank(\"RolandTR909\").gain(1.0), s(\"~ hh ~ hh\").bank(\"RolandTR909\").gain(0.5).delay(\"0.4:0.375:0.6\"))",
      "note": "Dub-techno: steady kick with delayed off-beat hats." },
    { "id": "ambient-no-kit", "family": "beatless", "genre": "ambient", "appliesTo": "any",
      "frag": "s(\"wind\").gain(0.35).room(0.8).lpf(1200).slow(2)",
      "note": "Pure texture bed, no drums; deep ambient." },
    { "id": "cinematic-pulse", "family": "half-time", "genre": "cinematic", "appliesTo": "any",
      "frag": "stack(note(\"c1\").s(\"sine\").gain(0.6).every(2, x => x.gain(0)), s(\"~ ~ cr ~\").bank(\"RolandTR909\").room(0.7).gain(0.5))",
      "note": "Cinematic heartbeat sub-pulse with swelled crash; trailer/score." },
    { "id": "dnb-amen", "family": "breakbeat", "genre": "dnb", "appliesTo": "any",
      "frag": "s(\"amencutup*4\").n(\"<0 1 2 3 4 5 6 7>\").fast(2).gain(0.95)",
      "note": "Amen break chops at DnB tempo; set ~170 BPM via setcpm." },
    { "id": "dnb-two-step", "family": "two-step", "genre": "dnb", "appliesTo": "any",
      "frag": "stack(s(\"bd ~ ~ ~ ~ ~ bd ~\").bank(\"RolandTR909\").gain(1.05), s(\"~ ~ ~ ~ sd ~ ~ ~\").bank(\"RolandTR909\").gain(1.0), s(\"hh*8\").bank(\"RolandTR909\").gain(0.4))",
      "note": "Two-step DnB skeleton; pairs with a rolling sub." },
    { "id": "footwork-160", "family": "footwork", "genre": "footwork", "appliesTo": "any",
      "frag": "stack(s(\"bd ~ bd [~ bd] bd ~ bd ~\").bank(\"RolandTR808\").gain(1.05), s(\"~ ~ ~ cp ~ ~ cp ~\").bank(\"RolandTR808\").gain(0.7))",
      "note": "Footwork/juke triplet-feel kick pattern with claps; ~160 BPM." },
    { "id": "jazz-brush-swing", "family": "swing", "genre": "jazz", "appliesTo": "any",
      "frag": "stack(s(\"rd ~ [rd rd] ~\").bank(\"AkaiMPC60\").gain(0.6), s(\"~ ~ bd ~\").bank(\"AkaiMPC60\").gain(0.6)).swingBy(0.12, 4)",
      "note": "Jazzy ride-led swing with soft kick; brushed feel." },
    { "id": "world-tabla", "family": "world-perc", "genre": "world", "appliesTo": "any",
      "frag": "stack(s(\"tabla*2 tabla2\").gain(0.7), s(\"~ mridangam_dhin ~ mridangam_ta\").gain(0.6)).swingBy(0.05, 8)",
      "note": "Tabla + mridangam hand-percussion bed; Indian/global fusion." },
    { "id": "afrobeat-shaker", "family": "world-perc", "genre": "world", "appliesTo": "any",
      "frag": "stack(s(\"conga*3\").gain(0.6), s(\"~ clave ~ clave ~ clave ~ ~\").gain(0.5), s(\"bd ~ ~ bd ~ ~ bd ~\").bank(\"LinnDrum\").gain(0.95))",
      "note": "Afrobeat/latin congas + clave over a loping kick." }
  ],
  "signatures": [
    { "id": "dub-chord-stabs", "genre": "dub", "appliesTo": "any",
      "frag": "note(\"~ <[c3,eb3,g3]> ~ <[ab2,c3,eb3]>\").s(\"sawtooth\").lpf(900).room(0.5).delay(\"0.5:0.375:0.6\").gain(0.5)",
      "note": "Off-beat dub chord stabs drenched in delay." },
    { "id": "arp-engine", "genre": "techno", "appliesTo": "any",
      "frag": "n(\"0 2 4 7\").scale(\"C3:minor\").s(\"square\").decay(0.1).sustain(0).gain(0.5)",
      "note": "Driving arpeggio." },
    { "id": "sub-bassline", "genre": "any", "appliesTo": "any",
      "frag": "note(\"<c1 c1 eb1 g0>*4\").s(\"sine\").lpf(300).gain(0.6)",
      "note": "Rolling sub bassline." },
    { "id": "piano-led", "genre": "hip-hop", "appliesTo": "any",
      "frag": "note(\"<[c3,eb3,g3] [ab2,c3,eb3]>\").s(\"piano\").room(0.4).gain(0.6)",
      "note": "Felt-piano chord lead." },

    { "id": "rhodes-jazz-7ths", "genre": "jazz", "appliesTo": "any",
      "frag": "note(\"<[c3,e3,g3,b3] [a2,c3,e3,g3] [d3,f3,a3,c4] [g2,b2,d3,f3]>\").s(\"piano\").room(0.4).gain(0.55)",
      "note": "ii-V jazzy 7th-chord progression; pairs with swing grooves." },
    { "id": "ambient-choir-pad", "genre": "ambient", "appliesTo": "any",
      "frag": "note(\"<c3 g3>/4\").s(\"swpad\").attack(2).release(3).room(0.8).lpf(sine.slow(16).range(600, 1800)).gain(0.45)",
      "note": "Slow-swelling pad with a long filter breath; ambient/cinematic." },
    { "id": "cinematic-string-swell", "genre": "cinematic", "appliesTo": "any",
      "frag": "note(\"<[c2,c3] [ab1,ab2] [f1,f2] [g1,g2]>/2\").s(\"sawtooth\").attack(1.5).release(2).lpf(1400).room(0.7).gain(0.5)",
      "note": "Sustained minor-key string swell for trailer/score beds." },
    { "id": "dnb-reese", "genre": "dnb", "appliesTo": "any",
      "frag": "note(\"<c1 c1 eb1 bb0>*2\").s(\"supersaw\").lpf(sine.slow(8).range(200, 1200)).resonance(8).gain(0.55)",
      "note": "Detuned Reese bass with a moving filter; DnB/neurofunk." },
    { "id": "footwork-vocal-chop", "genre": "footwork", "appliesTo": "any",
      "frag": "s(\"think\").chop(16).speed(\"<1 1.5 0.75>\").n(\"0 2 4 6 8 10\").gain(0.5).room(0.3)",
      "note": "Stuttered vocal/break chops; footwork/juke signature." },
    { "id": "world-sitar-motif", "genre": "world", "appliesTo": "any",
      "frag": "n(\"0 3 5 7 5 3\").scale(\"C4:phrygian\").s(\"sitar\").gain(0.5).room(0.4).delay(\"0.3:0.25:0.4\")",
      "note": "Modal sitar motif in phrygian; global/raga colour." },
    { "id": "lofi-vibraphone", "genre": "hip-hop", "appliesTo": "any",
      "frag": "note(\"<[c4,eb4,g4] [bb3,d4,f4]>\").s(\"vibraphone\").room(0.5).gain(0.5).speed(0.99)",
      "note": "Mellow vibraphone chords, slightly detuned; lo-fi/jazz-hop." },
    { "id": "fm-bell-lead", "genre": "ambient", "appliesTo": "any",
      "frag": "note(\"<c4 g4 eb4 bb3>\").s(\"sine\").fm(4).fmh(2).decay(0.4).sustain(0.1).room(0.6).gain(0.5)",
      "note": "FM bell/electric-piano lead; original synthesized timbre." }
  ]
}
